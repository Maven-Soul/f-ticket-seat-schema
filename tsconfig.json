{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "vue": ["./node_modules/vue"],
      "@lucide/vue": ["./node_modules/@lucide/vue"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
